# Copy to .env and adjust. docker-compose reads these.

# --- Postgres ---
POSTGRES_USER=ssuser
POSTGRES_PASSWORD=sspassword
POSTGRES_DB=sstax

# --- Backend ---
# Host "db" is the compose service name; port 5432 is the in-network port.
DATABASE_URL=postgres://ssuser:sspassword@db:5432/sstax?sslmode=disable
JWT_SECRET=change-me-to-a-long-random-string
PORT=8080

# Public URL of the frontend. Used to build links in verification email and the
# billing return URL. Match the host-mapped frontend port below.
APP_BASE_URL=http://localhost:5174

# --- Email (Resend) ---
# Leave RESEND_API_KEY empty for local dev: verification links are logged to the
# backend console instead of emailed (and returned to the register call as
# dev_verify_link). For real delivery, create a key at https://resend.com and
# verify your sender domain (SPF/DKIM). onboarding@resend.dev works for testing.
RESEND_API_KEY=
EMAIL_FROM=SS Tax Engine <onboarding@resend.dev>

# --- Billing (Dodo Payments) ---
# Leave these empty for local dev: checkout is disabled and /api/billing/verify
# grants Pro locally so you can exercise the Pro experience without paying.
# For test mode, create a Pro product + a webhook endpoint in the Dodo dashboard.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_SECRET=
DODO_PRO_PRODUCT_ID=
DODO_ENV=test_mode

# --- Frontend ---
# Base URL the browser uses to reach the backend (host-mapped port).
VITE_API_URL=http://localhost:8080
